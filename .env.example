# EvidenceOS / VeriDock Configuration
APP_ENV=development
APP_NAME=EvidenceOS
APP_PORT=8000

# Database: Supports PostgreSQL (+pgvector) or local SQLite fallback
# Example Postgres: postgresql+psycopg2://evidenceos:evidenceos@localhost:5432/evidenceos
DATABASE_URL=sqlite:///./data/evidenceos.db

# Storage Backend: local or s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/evidence_store
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration
# Options: gemini, heuristic_local (deterministic + content-aware local analyzer when offline/no API key)
AI_PROVIDER=heuristic_local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & Authentication
# API Key required for protected administrative/mutation routes when AUTH_REQUIRED=true
AUTH_REQUIRED=false
API_SECRET_KEY=dev-evidenceos-secret-key-change-in-prod
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# VeriDock Default SLA & Contract Thresholds
SLA_MAX_AUTO_APPROVE_DAMAGE_RATIO=0.25
SLA_MIN_CONFIDENCE_THRESHOLD=0.75
PERCEPTUAL_HASH_HAMMING_THRESHOLD=10
